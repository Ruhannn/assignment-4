model Car {
  id          String   @id @default(uuid())
  brand       String
  model       String
  dailyRate   Float
  location    String
  isAvailable Boolean  @default(true)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}
